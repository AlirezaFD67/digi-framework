{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "types": ["react", "react-dom"] ,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
